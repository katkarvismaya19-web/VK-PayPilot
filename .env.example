# ---- PayPilot AI configuration ----
# Everything works WITHOUT any keys: the agent falls back to its built-in
# rule-based planner and Razorpay runs in sandbox/mock mode.

# Database (SQLite by default, Postgres works too: postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:///./paypilot.db

# LLM provider: "anthropic", "openai", or "none" (rule-based fallback)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Razorpay (get test keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Agent guardrails
AUTO_EXECUTE=false            # true = agent executes low-risk actions without approval
MAX_DISCOUNT_PERCENT=20       # agent can never offer more than this
MAX_ACTIONS_PER_CUSTOMER_PER_WEEK=2
